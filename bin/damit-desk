#!/bin/sh
# DamIT Desk. The only window. This does not open QGIS.
set -e
# --profile nd opens the desk in the North Dakota profile (DWR dam values, the DWR DamSafety plugins); --profile us
# in the United States one. Without it the desk opens in the profile last chosen in Settings.
if [ "${1:-}" = "--profile" ] && [ -n "${2:-}" ]; then
  DAMIT_DESK_PROFILE="$2"; export DAMIT_DESK_PROFILE; shift 2
fi
HERE=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
APP=$(CDPATH= cd -- "$HERE/../app/desktop" && pwd)
PY="${DAMIT_DESK_PYTHON:-python3}"
case "$(uname -s)" in
  Darwin)
    # A native window on Mac: pywebview, in a virtualenv next to the app (made on the first run).
    VENV="$APP/.venv"
    if [ ! -x "$VENV/bin/python" ]; then
      "$PY" -m venv "$VENV"
    fi
    # Install pywebview only when it is not already there, so a normal launch is fast and works offline.
    "$VENV/bin/python" -c 'import webview' 2>/dev/null || "$VENV/bin/python" -m pip install -q 'pywebview>=5.0,<7'
    RUN="$VENV/bin/python"
    ;;
  *)
    # Linux stays in the browser so Qt is not installed. The desk itself needs only Python's standard library,
    # so there is no virtualenv to make (and no python3-venv package to install).
    RUN="$PY"
    ;;
esac
cd "$APP"
exec "$RUN" run.py
