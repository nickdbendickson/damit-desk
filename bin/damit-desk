#!/bin/sh
# DamIT Desk. The only window. This does not open QGIS.
set -e
HERE=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
APP=$(CDPATH= cd -- "$HERE/../app/desktop" && pwd)
PY="${DAMIT_DESK_PYTHON:-python3}"
VENV="$APP/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  "$PY" -m venv "$VENV"
fi
# A native window on Mac. Linux stays in the browser so Qt is not installed.
case "$(uname -s)" in
  Darwin)
    "$VENV/bin/python" -m pip install -q 'pywebview>=5.0,<7'
    ;;
esac
cd "$APP"
exec "$VENV/bin/python" run.py
